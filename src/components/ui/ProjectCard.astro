---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { title, industry, challenge, approach, outcomes, caseStudyUrl, placeholder } = project.data;
const headingId = `project-${project.id}`;

const details = [
  { term: 'Challenge', value: challenge },
  { term: 'Approach', value: approach },
  { term: 'Outcomes', value: outcomes },
];
---

<article
  aria-labelledby={headingId}
  class:list={[
    'grid gap-6 border-b border-line py-10 md:grid-cols-[minmax(0,14rem)_1fr] md:gap-10',
    placeholder && 'project-demo',
  ]}
>
  <div class="flex items-start justify-between gap-4 md:flex-col md:justify-start">
    <span class="font-mono text-sm text-accent tabular-nums" aria-hidden="true">
      {String(index).padStart(2, '0')}
    </span>
    {placeholder && (
      <span class="rounded-full border border-dashed border-line-strong px-2.5 py-0.5 font-mono text-[0.6875rem] tracking-wider text-ink-subtle uppercase">
        Demonstration
      </span>
    )}
  </div>

  <div>
    <p class="eyebrow">{industry}</p>
    <h3 id={headingId} class="mt-3 text-title">{title}</h3>

    <dl class="mt-6 grid gap-6 border-t border-line pt-6 lg:grid-cols-3 lg:gap-8">
      {details.map((item) => (
        <div>
          <dt class="text-[0.8125rem] font-semibold tracking-wide text-ink">{item.term}</dt>
          <dd class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">{item.value}</dd>
        </div>
      ))}
    </dl>

    {caseStudyUrl ? (
      <a href={caseStudyUrl} class="link-underline mt-6 inline-flex items-center gap-2 text-[0.9375rem] font-medium">
        Read the case study<span class="sr-only">: {title}</span>
        <span aria-hidden="true">→</span>
      </a>
    ) : (
      <p class="mt-6 text-sm text-ink-subtle">Full case study coming soon.</p>
    )}
  </div>
</article>
