---
import { site, navigation } from '@/config/site';
---

<header
  class="site-header theme-navy sticky top-0 z-40 border-b border-transparent bg-paper transition-colors duration-200"
  data-site-header
>
  <div class="page-container flex h-(--spacing-header) items-center justify-between gap-6">
    <a href="/" class="group flex items-baseline gap-3" aria-label={`${site.name} — home`}>
      <span class="font-display text-[1.375rem] leading-none font-[650] tracking-[-0.02em]">
        {site.name}<span class="text-accent" aria-hidden="true">.</span>
      </span>
      <span class="eyebrow hidden lg:inline">{site.jobTitle}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-control px-3 py-2 text-[0.9375rem] text-ink-muted transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex size-11 items-center justify-center rounded-control text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>Open menu</span>
      <svg class="menu-icon" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line class="menu-line menu-line-top" x1="3" y1="7.5" x2="19" y2="7.5"></line>
        <line class="menu-line menu-line-bottom" x1="3" y1="14.5" x2="19" y2="14.5"></line>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary"
    class="mobile-nav border-t border-line bg-paper md:hidden"
    hidden
    data-mobile-nav
  >
    <ul class="page-container flex flex-col py-4">
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center justify-between border-b border-line py-4 font-display text-2xl last:border-b-0"
              data-mobile-link
            >
              {item.label}
              <span class="text-accent" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-line);
  }

  .menu-line {
    transform-origin: 11px 11px;
    transition: transform 200ms var(--ease-out-soft);
  }
  [aria-expanded='true'] .menu-line-top {
    transform: translateY(3.5px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-line-bottom {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-line {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  function setMenu(open: boolean): void {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  panel?.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });

  // Hairline border once the page is scrolled.
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-scrolled', !entry?.isIntersecting);
    }).observe(sentinel);
  }
</script>
